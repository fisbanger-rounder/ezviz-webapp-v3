# ── Appwrite Function Configuration ──────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored (covered by *.local in .gitignore).
#
# Where to find these values after setup:
#   VITE_APPWRITE_ENDPOINT    → https://cloud.appwrite.io/v1  (or your self-hosted URL)
#   VITE_APPWRITE_PROJECT_ID  → Appwrite Console → your Project → Settings → Project ID
#   VITE_APPWRITE_FUNCTION_ID → Appwrite Console → Functions → ezviz-login → Settings → Function ID

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a75420f00029b31c854
VITE_APPWRITE_FUNCTION_ID=6a75449e000ee027b0b1
